% layout 'default';
% title 'MIDI Filter';

<div class="container pb-5">

% if (my $msg = flash('message')) {
  <div class="alert alert-success" role="alert"><%= $msg %></div>
% }
% if (my $err = flash('error')) {
  <div class="alert alert-danger" role="alert"><%= $err %></div>
% }

  <div class="card mb-4">
    <div class="card-header">Filter Sets</div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-4">
          <form method="post" action="<%= url_for('save_set') %>" class="d-flex gap-2 align-items-end">
            <%= csrf_field %>
            <div class="flex-grow-1">
              <label class="form-label">Save current filters as</label>
              <input type="text" name="set_name" class="form-control" placeholder="e.g. Live Rig" required
                title="Name to save the current filter list under" <%= $any_running ? 'disabled' : '' %>>
            </div>
            <button type="submit" class="btn btn-outline-primary" <%= (@$filters && !$any_running) ? '' : 'disabled' %>
              title="Save the current filter list as a named set">Save</button>
          </form>
        </div>

        <div class="col-md-8">
          <form method="post" action="<%= url_for('load_set') %>" class="d-flex gap-2 align-items-end">
            <%= csrf_field %>
            <div class="flex-grow-1">
              <label class="form-label">Saved sets</label>
              <select id="saved-set-select" name="set_name" class="form-select" <%= (@$saved_sets && !$any_running) ? '' : 'disabled' %>
                title="Choose a saved set to load or delete">
                <option value="" <%= (defined $current_set && length $current_set) ? '' : 'selected' %>>Select...</option>
% for my $name (@$saved_sets) {
                <option value="<%= $name %>" <%= (defined $current_set && $current_set eq $name) ? 'selected' : '' %>><%= $name %></option>
% }
              </select>
            </div>
            <button type="submit" id="load-set-btn" formaction="<%= url_for('load_set') %>" class="btn btn-outline-primary"
              <%= (@$saved_sets && !$any_running && defined $current_set && length $current_set) ? '' : 'disabled' %>
              title="Replace the current filter list with the selected saved set"
              onclick="return confirm('Replace the current filter list with this saved set?');">Load</button>
            <button type="submit" id="delete-set-btn" formaction="<%= url_for('delete_set') %>" class="btn btn-outline-danger"
              <%= (@$saved_sets && !$any_running && defined $current_set && length $current_set) ? '' : 'disabled' %>
              title="Delete the selected saved set"
              onclick="return confirm('Delete this saved set? This can\'t be undone.');">Delete</button>
          </form>
        </div>
      </div>
% if (!@$saved_sets) {
      <p class="text-muted mt-3 mb-0">No saved sets yet — save your current filter list above.</p>
% }
    </div>
    <div class="card-footer d-flex gap-2">
      <form method="post" action="<%= url_for('start_all') %>" class="d-inline">
        <%= csrf_field %>
        <button type="submit" class="btn btn-success btn-sm" <%= (@$filters && !$any_running) ? '' : 'disabled' %>
          title="Start every configured filter">Start</button>
      </form>
      <form method="post" action="<%= url_for('stop_all') %>" class="d-inline">
        <%= csrf_field %>
        <button type="submit" class="btn btn-outline-dark btn-sm" <%= $any_running ? '' : 'disabled' %>
          title="Stop every running filter">Stop</button>
      </form>
      <form method="post" action="<%= url_for('clear_filters') %>" class="d-inline">
        <%= csrf_field %>
        <button type="submit" class="btn btn-outline-secondary btn-sm" <%= (@$filters && !$any_running) ? '' : 'disabled' %>
          title="Delete every configured filter"
          onclick="return confirm('Delete all configured filters? Running filters will be stopped first. This can\'t be undone.');">Clear</button>
      </form>
    </div>
  </div>

% if (!@$filters) {
  <p class="text-muted">No filters configured yet — add one below.</p>
% } else {
  <div class="table-responsive mb-4">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Status</th>
          <th>Name</th>
          <th>Filter</th>
          <th>Input</th>
          <th>Output</th>
          <th>Ch</th>
          <th>CC</th>
          <th>Trig</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
% for my $f (@$filters) {
%   my $is_running = $running->{ $f->{id} };
        <tr>
          <td>
% if ($is_running) {
            <span class="badge bg-success">running</span>
% } else {
            <span class="badge bg-secondary">stopped</span>
% }
          </td>
          <td><%= $f->{name} %></td>
          <td><code><%= $f->{filter} %></code></td>
          <td><%= $f->{input} %></td>
          <td><%= $f->{output} %></td>
          <td><%= $f->{channel} // '—' %></td>
          <td><%= $f->{control} // '—' %></td>
          <td><%= $f->{trigger} // '—' %></td>
          <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
              <form method="post" action="<%= url_for('edit') %>" class="d-inline">
                <%= csrf_field %>
                <input type="hidden" name="edit_id" value="<%= $f->{id} %>">
                <button type="submit" class="btn btn-outline-secondary" <%= $any_running ? 'disabled' : '' %>
                  title="Edit this filter's settings">Edit</button>
              </form>
              <form method="post" action="<%= url_for('delete') %>" class="d-inline"
                    onsubmit="return confirm('Delete this filter?');">
                <%= csrf_field %>
                <input type="hidden" name="delete_id" value="<%= $f->{id} %>">
                <button type="submit" class="btn btn-outline-danger" <%= $any_running ? 'disabled' : '' %>
                  title="Delete this filter">Delete</button>
              </form>
            </div>
          </td>
        </tr>
% }
      </tbody>
    </table>
  </div>
% }

  <div class="card">
    <div class="card-header">
      <%= keys %$edit ? 'Edit Filter' : 'Add Filter' %>
    </div>
    <div class="card-body">
      <form method="post" action="<%= url_for('filters') %>">
        <%= csrf_field %>
% if (keys %$edit) {
        <input type="hidden" name="edit_id" value="<%= $edit->{id} %>">
% }

        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" required
              value="<%= $edit->{name} // '' %>" placeholder="e.g. Mod Wheel Breathe"
              title="A label to identify this filter">
          </div>

          <div class="col-md-4">
            <label class="form-label">Filter type</label>
            <select name="filter" class="form-select" required title="Which filter algorithm to run">
% for my $type (@$filter_types) {
              <option value="<%= $type %>" <%= ($edit->{filter} // 'single') eq $type ? 'selected' : '' %>><%= $type %></option>
% }
            </select>
          </div>

          <div class="col-md-4">
            <div class="form-check mt-4 pt-2">
              <input type="checkbox" class="form-check-input" id="verbose" name="verbose" value="1"
                title="Log extra detail while this filter runs"
                <%= $edit->{verbose} ? 'checked' : '' %>>
              <label class="form-check-label" for="verbose">Verbose</label>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label">Input port</label>
            <select id="input-ports" name="input" class="form-select" list="input-ports" required
              title="MIDI input device to listen on">
              <option value="" disabled <%= $edit->{input} ? '' : 'selected' %>>Choose input...</option>
% for my $p (@$inputs) {
              <option value="<%= $p %>" <%= $edit->{input} && $edit->{input} eq $p ? 'selected' : '' %>><%= $p %></option>
% }
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label">Output port</label>
            <select id="output-ports" name="output" class="form-select" list="output-ports" required
              title="MIDI output device to send to">
              <option value="" disabled <%= $edit->{output} ? '' : 'selected' %>>Choose output...</option>
% for my $p (@$outputs) {
              <option value="<%= $p %>" <%= $edit->{output} && $edit->{output} eq $p ? 'selected' : '' %>><%= $p %></option>
% }
            </select>
          </div>

          <div class="col-md-3">
            <label class="form-label">Channel (0–15)</label>
            <input type="number" name="channel" class="form-control" min="0" max="15" required
              value="<%= $edit->{channel} // '' %>" title="MIDI channel!">
          </div>
          <div class="col-md-3">
            <label class="form-label">Control (CC#)</label>
            <input type="number" name="control" class="form-control" min="0" max="127" required
              value="<%= $edit->{control} // '' %>" title="Control-change number (CC#) this filter controls">
          </div>
          <div class="col-md-3">
            <label class="form-label">Trigger (CC#)</label>
            <input type="number" name="trigger" class="form-control" min="0" max="127"
              value="<%= $edit->{trigger} // '' %>" title="Note or CC# that is triggered by this filter">
          </div>
          <div class="col-md-3">
            <label class="form-label">Value (0–127)</label>
            <input type="number" name="value" class="form-control" min="0" max="127"
              value="<%= $edit->{value} // '' %>" title="Control-change value of this filter">
          </div>

          <div class="col-md-3">
            <label class="form-label">Initial point (0–127)</label>
            <input type="number" name="initial_point" class="form-control" min="0" max="127"
              value="<%= $edit->{initial_point} // '' %>" title="Starting value before the filter begins iterating">
          </div>
          <div class="col-md-3">
            <label class="form-label">Range bottom (0–127)</label>
            <input type="number" name="range_bottom" class="form-control" min="0" max="127"
              value="<%= $edit->{range_bottom} // '' %>" title="Lowest value in the filter's range">
          </div>
          <div class="col-md-3">
            <label class="form-label">Range top (0–127)</label>
            <input type="number" name="range_top" class="form-control" min="0" max="127"
              value="<%= $edit->{range_top} // '' %>" title="Highest value in the filter's range">
          </div>
          <div class="col-md-3">
            <label class="form-label">Range step (num)</label>
            <input type="number" name="range_step" class="form-control" min="1" max="127"
              value="<%= $edit->{range_step} // '' %>" title="Amount to step by within the range">
          </div>

          <div class="col-md-3">
            <label class="form-label">Time step (sec)</label>
            <input type="number" name="time_step" class="form-control" step="0.01" min="0"
              value="<%= $edit->{time_step} // '' %>" title="Seconds between each iteration">
          </div>
          <div class="col-md-3">
            <label class="form-label">Step up (num)</label>
            <input type="number" name="step_up" class="form-control" min="0" max="127"
              value="<%= $edit->{step_up} // '' %>" title="Amount to increase by on an upward step">
          </div>
          <div class="col-md-3">
            <label class="form-label">Step down (num)</label>
            <input type="number" name="step_down" class="form-control" min="0" max="127"
              value="<%= $edit->{step_down} // '' %>" title="Amount to decrease by on a downward step">
          </div>
        </div>

        <div class="mt-4">
          <button type="submit" class="btn btn-primary" <%= $any_running ? 'disabled' : '' %>
            title="<%= keys %$edit ? 'Save changes to this filter' : 'Add this filter to the configured list' %>">
            <%= keys %$edit ? 'Save Changes' : 'Add Filter' %>
          </button>
% if (keys %$edit) {
          <a href="<%= url_for('cancel') %>" class="btn btn-outline-secondary">Cancel</a>
% }
        </div>
      </form>
    </div>
  </div>

</div>

<script>
  (function () {
    var select = document.getElementById('saved-set-select');
    var loadBtn = document.getElementById('load-set-btn');
    var deleteBtn = document.getElementById('delete-set-btn');
    if (!select || !loadBtn || !deleteBtn) return;

    select.addEventListener('change', function () {
      // Respect the select's own disabled state (set server-side when
      // filters are running or there are no saved sets) — only toggle
      // Load/Delete based on selection when the select is usable.
      var shouldDisable = select.disabled || select.value === '';
      loadBtn.disabled = shouldDisable;
      deleteBtn.disabled = shouldDisable;
    });
  })();
</script>
