<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= stash('title') // 'MBTI' %></title>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <script src="/js/bootstrap.bundle.min.js"></script>
  <script src="/js/jquery-3.7.1.min.js"></script>
</head>
<body>
<div class="container py-4">

  <header class="d-flex flex-wrap justify-content-between align-items-center pb-3 mb-4 border-bottom">
    <h1 class="h3 mb-2 mb-md-0"><%= title %></h1>
  </header>

  <main>
    <%= content %>
  </main>

  <footer class="text-center text-muted small mt-5 pt-3 border-top">
    &copy; <%= (localtime)[5] + 1900 %> &middot;
    Built with <a href="https://mojolicious.org/">Mojolicious</a>
  </footer>

</div>

</body>
</html>
